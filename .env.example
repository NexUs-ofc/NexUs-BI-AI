# Copie este arquivo para .env e preencha

# LangSmith (rastreamento do grafo e dos agentes). Deixe false para não enviar nada.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# LLM (Gemini)
GOOGLE_API_KEY=
JWT_SECRET_BASE64=
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
MAX_JUDGE_RETRIES=1

# Chave que o cliente precisa mandar no header X-API-Key para usar a API
API_KEY=

# Qdrant (FAQ). Para testar sem servidor: QDRANT_URL=:memory:
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_FAQ=faq
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
FAQ_TOP_K=4
FAQ_PATH=app/static/faq.json

# PostgreSQL do Auth (só para conferir se a empresa logada existe e está ativa)
PGSQL_URL=postgresql://usuario:senha@host:5432/banco

# MongoDB (relatórios consolidados lidos pelo Analista e pelo Recomendador)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=nexus_bi
MONGODB_REPORTS_COLLECTION=reports
REPORTS_LATEST_LIMIT=3
REPORTS_MAX_MONTHS=24
REPORTS_MAX_CHARS=60000

# ---------------------------------------------------------------------------------------------------
# Gerador de relatórios (report_generator/). Usa também GOOGLE_API_KEY, API_KEY, JWT_SECRET_BASE64 e
# MONGODB_* acima: grava na mesma coleção que o chatbot lê.
# Fonte dos dados do mês: mock (por enquanto) ou db (quando a base limpa existir)
REPORT_DATA_SOURCE=mock
REPORT_MOCK_SEED=42
# UF com menos households que isso não mostra números (privacidade)
REPORT_MIN_HOUSEHOLDS=10
# Quantos meses anteriores os agentes leem do Mongo
REPORT_HISTORY_MONTHS=6
# Modelo do gerador (padrão: o mesmo LLM_MODEL do chatbot)
REPORT_LLM_MODEL=
# Perfis do token que podem ver e que podem gerar/publicar relatórios
REPORT_READ_PROFILES=COMPANY,ADMIN
REPORT_WRITE_PROFILES=ADMIN
MONGODB_REPORT_JOBS_COLLECTION=report_jobs
# PDFs no Google Cloud Storage. Vazio = salva em REPORT_OUTPUT_DIR (desenvolvimento)
GCS_BUCKET=
GCS_PREFIX=relatorios
REPORT_OUTPUT_DIR=output/relatorios
# Credenciais do GCS fora do Cloud Run: caminho do JSON da service account
# GOOGLE_APPLICATION_CREDENTIALS=C:\caminho\service-account.json
