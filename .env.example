# Copie este arquivo para .env e preencha

# LangSmith (rastreamento do grafo e dos agentes). Deixe false para não enviar nada.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# LLM (Gemini)
GOOGLE_API_KEY=
JWT_SECRET_BASE64=
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
MAX_JUDGE_RETRIES=1

# Chave que o cliente precisa mandar no header X-API-Key para usar a API
API_KEY=

# Chave do painel do administrador (header X-Admin-Key), a mesma em todos os serviços do NexUs
ADMIN_API_KEY=
# Teto diário de tokens desenhado no gráfico do painel (0 = sem teto)
DAILY_TOKEN_LIMIT=0

# Qdrant (FAQ). Para testar sem servidor: QDRANT_URL=:memory:
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_FAQ=faq
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
FAQ_TOP_K=4
FAQ_PATH=app/static/faq.json

# PostgreSQL do Auth (só para conferir se a empresa logada existe e está ativa)
PGSQL_URL=postgresql://usuario:senha@host:5432/banco

# MongoDB (relatórios consolidados lidos pelo Analista e pelo Recomendador)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=nexus_bi
MONGODB_REPORTS_COLLECTION=reports
REPORTS_LATEST_LIMIT=3
REPORTS_MAX_MONTHS=24
REPORTS_MAX_CHARS=15000
