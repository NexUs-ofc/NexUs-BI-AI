# Copie este arquivo para .env e preencha

# LangSmith (rastreamento do grafo e dos agentes). Deixe false para não enviar nada.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# LLM (Gemini)
GOOGLE_API_KEY=
JWT_SECRET_BASE64=
LLM_MODEL=gemini-3.8-flash
# Raciocínio do Gemini 3.x: low (chat em tempo real, padrão) | medium (padrão do modelo, mais lento) | high
LLM_THINKING_LEVEL=low
# Limite de cada chamada ao Gemini e novas tentativas do SDK em 408/409/429/5xx (0 vale como 1)
LLM_TIMEOUT_S=30
# Modelo de reserva se o principal falhar (503 alta demanda, 429, timeout). Vazio desliga.
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_MAX_RETRIES=1
# Só para gemini-2.x (o 3.x não aceita temperature)
LLM_TEMPERATURE=0.2
# Se a resposta citar número fora dos dados consultados, refaz até N vezes
MAX_JUDGE_RETRIES=1
# Limite da pergunta inteira no POST /chat (acima disso responde 504)
CHAT_TIMEOUT_S=120
# Perfis do token que usam o chat e os rankings (COMPANY precisa estar ativa no Postgres do Auth)
CHAT_PROFILES=COMPANY,ADMIN
# INFO mostra cada etapa do chat com o tempo; DEBUG mostra também cada tentativa HTTP ao Gemini
LOG_LEVEL=INFO

# Chave que o cliente precisa mandar no header X-API-Key para usar a API
API_KEY=

# Chave do painel do administrador (header X-Admin-Key), a mesma em todos os serviços do NexUs
ADMIN_API_KEY=
# Teto diário de tokens desenhado no gráfico do painel (0 = sem teto)
DAILY_TOKEN_LIMIT=0

# Qdrant (FAQ). Para testar sem servidor: QDRANT_URL=:memory:
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_FAQ=faq
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
FAQ_TOP_K=4
FAQ_PATH=app/static/faq.json

# PostgreSQL compartilhado: empresa ativa e leitura de public.food para os rankings
PGSQL_URL=postgresql://usuario:senha@host:5432/banco

# MongoDB (relatórios consolidados lidos pelo Analista e pelo Recomendador)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=nexus_bi
MONGODB_REPORTS_COLLECTION=reports
REPORTS_LATEST_LIMIT=3
REPORTS_MAX_MONTHS=24
REPORTS_MAX_CHARS=60000

# ---------------------------------------------------------------------------------------------------
# Gerador de relatórios (report_generator/). Usa também GOOGLE_API_KEY, API_KEY, JWT_SECRET_BASE64 e
# MONGODB_* acima: grava na mesma coleção que o chatbot lê.
# Fonte dos dados do mês: databricks (Gold, padrão). "mock" gera dados FICTÍCIOS: só para testes
REPORT_DATA_SOURCE=databricks
# Databricks, camada Gold (REPORT_DATA_SOURCE=databricks). Serverless Starter Warehouse > Connection details;
# token pessoal em User settings > Developer. Só no servidor, nunca no front-end
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=gold
# UF com menos lotes que isso fica fora do ranking D5 e do mapa (regra da Gold)
REPORT_MIN_LOTES_UF=30
# UF com menos households que isso não mostra números (privacidade)
REPORT_MIN_HOUSEHOLDS=10
# Quantos meses anteriores os agentes leem do Mongo
REPORT_HISTORY_MONTHS=6
# Modelo do gerador (padrão: o mesmo LLM_MODEL do chatbot)
REPORT_LLM_MODEL=
# Perfis do token que podem ver e que podem gerar relatórios
REPORT_READ_PROFILES=COMPANY,ADMIN
REPORT_WRITE_PROFILES=ADMIN
MONGODB_REPORT_JOBS_COLLECTION=report_jobs
# PDFs no Supabase Storage (bucket PRIVADO). SUPABASE_URL vazio = salva em REPORT_OUTPUT_DIR (desenvolvimento)
SUPABASE_URL=
# Service role key: Project Settings > API. Só no servidor, nunca no front-end
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=relatorio
SUPABASE_PREFIX=relatorios
REPORT_OUTPUT_DIR=output/relatorios
# Horários (de Brasília, separados por vírgula) em que o GET /dashboard busca a Gold de novo; fora desses
# horários devolve o que já tem guardado em memória. A Gold só é atualizada 1x por dia (07h, pelo
# Job_NexUs_BI); o padrão 8h/20h garante no máximo 2 buscas por dia por mês pedido, já depois da carga.
REPORT_DASHBOARD_REFRESH_HOURS=8,20
# Agendamento (a API gera sozinha, com IA e PDF). diario = todo dia gera o MÊS ATUAL parcial (e fecha o anterior
# quando o mês vira); mensal = só no dia REPORT_SCHEDULE_DAY gera o mês que acabou.
# A Gold do Databricks atualiza às 07:00 (Brasília): deixe a hora DEPOIS disso (padrão 8).
REPORT_SCHEDULE_ENABLED=true
REPORT_SCHEDULE_FREQUENCY=diario
REPORT_SCHEDULE_HOUR=8
REPORT_SCHEDULE_DAY=1
# Cache em memória da leitura da Gold (poupa a cota do warehouse Free) e validade da URL assinada do PDF
REPORT_GOLD_CACHE_SECONDS=1800
REPORT_PDF_URL_EXPIRES=600

# ---------------------------------------------------------------------------------------------------
# Upstash Redis (rankings de produtos)
# Crie um banco em https://console.upstash.com/redis e copie a REST URL e o REST Token.
REDIS_REST_URL=
REDIS_REST_TOKEN=
