# Copie este arquivo para .env e preencha a chave
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
# Base usada pelo Analista descritivo e pelo Recomendador
DATA_PATH=app/static/vendas_exemplo.csv
FAQ_PATH=app/static/faq.json
# Quantas vezes o Orquestrador pode refazer a resposta se o Juiz reprovar
MAX_TENTATIVAS_JUIZ=1
