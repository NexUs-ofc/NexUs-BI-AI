# Copie este arquivo para .env e preencha

# LLM (Gemini)
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
MAX_JUDGE_RETRIES=1

# Chave que o cliente precisa mandar no header X-API-Key para usar a API
API_KEY=

# Qdrant (FAQ). Para testar sem servidor: QDRANT_URL=:memory:
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_FAQ=faq
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
FAQ_TOP_K=4
FAQ_PATH=app/static/faq.json
